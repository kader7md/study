; Engine configuration file.
; Trust Issues: co-op train chase with a secret impostor.

config_version=5

[application]

config/name="Trust Issues"
config/description="Co-op train chase with a secret impostor."
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/autoload/game.gd"
Settings="*res://scripts/autoload/settings.gd"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="train"
3d_physics/layer_4="interact"
3d_physics/layer_5="enemy"
3d_physics/layer_6="debris"
3d_render/layer_2="own_body"

[physics]

common/physics_ticks_per_second=60
